# Optional YC product integrations. The app runs locally without them.
SUPABASE_URL=
SUPABASE_KEY=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Used only for HMAC signing of deployment bundles in the demo.
# In production use a KMS/HSM-backed key and rotate it.
CATEGORY_FORGE_SIGNING_SECRET=replace-me-in-production
